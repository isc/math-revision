# Configuration pour la génération d'images

# OpenAI DALL-E 3 (recommandé pour la France/Europe)
# Obtenez votre clé API sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Option alternative: Gemini 2.5 Flash (non disponible en France via API gratuite)
# GOOGLE_API_KEY=your-google-api-key-here

# Instructions:
# 1. Copiez ce fichier vers .env: cp .env.example .env
# 2. Remplacez your-openai-api-key-here par votre vraie clé API OpenAI
# 3. Lancez pour niveau 1: node scripts/generate-images.js 1
# 4. Lancez pour tous: node scripts/generate-images.js
